  title        = {Unicode {CLDR} 48, \texttt{common/main/} \texttt{he.xml}, \texttt{zh.xml}, \texttt{zh\_Hant.xml}, \texttt{yue.xml}, \texttt{yue\_Hans.xml}, \texttt{ja.xml} and \texttt{ko.xml}: the Hebrew and Chinese calendars' dates},
  howpublished = {\url{https://github.com/unicode-org/cldr/tree/release-48/common/main}},
